# Gym Timer local config
# Copy this file to .env and edit before running:
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)

# FastAPI bind address
API_HOST=0.0.0.0
API_PORT=8000

# Vite frontend port
VITE_PORT=5173

# Leave empty to use the Vite /api proxy (recommended for local + ngrok).
# Set only if the frontend should call another API origin directly.
VITE_API_URL=

# Where Vite proxies /api requests
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional ngrok reserved domain (hostname only, no https://).
# Leave empty to skip the public tunnel. Requires ngrok on PATH.
NGROK_DOMAIN=
